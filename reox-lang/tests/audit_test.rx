// Test 1: else-if chains
fn test_else_if() -> int {
    let x: int = 5;
    if x > 10 {
        return 3;
    } else if x > 3 {
        return 2;
    } else {
        return 1;
    }
}

// Test 2: global variables
let mut counter: int = 0;
let app_name: string = "Calculator";

fn increment() -> void {
    counter = counter + 1;
}

// Test 3: string interpolation
fn greet(name: string) -> string {
    return "Hello, \(name)!";
}

fn main() -> int {
    // Test else-if
    let result: int = test_else_if();
    println(int_to_string(result));

    // Test globals
    increment();
    increment();
    println(int_to_string(counter));
    println(app_name);

    // Test string interpolation
    let msg: string = greet("REOX");
    println(msg);

    return 0;
}

extern fn println(s: string) -> void;
extern fn int_to_string(i: int) -> string;
extern fn string_concat(a: string, b: string) -> string;
extern fn str(s: string) -> string;
