{
    "name": "REOX Ketivee Light",
    "type": "light",
    "colors": {
        "editor.background": "#F8F7FC",
        "editor.foreground": "#211B2B",
        "editorLineNumber.foreground": "#8B8296",
        "editorLineNumber.activeForeground": "#5B46CD",
        "editor.lineHighlightBackground": "#F0ECFA",
        "editor.selectionBackground": "#D8CCF2",
        "editorCursor.foreground": "#7045C5",
        "editorWhitespace.foreground": "#D8D1E2",
        "editorIndentGuide.background": "#E4DEEC",
        "editorIndentGuide.activeBackground": "#B49AE0",
        "editorGutter.background": "#F8F7FC",
        "editorBracketMatch.background": "#EAE2F7",
        "editorBracketMatch.border": "#8E6BD0",
        "editorOverviewRuler.border": "#F8F7FC",
        "sideBar.background": "#F1EFF7",
        "sideBar.foreground": "#2A2335",
        "sideBar.border": "#E1DCEB",
        "activityBar.background": "#EAE5F4",
        "activityBar.foreground": "#5B46CD",
        "statusBar.background": "#5B46CD",
        "statusBar.foreground": "#FFFFFF",
        "titleBar.activeBackground": "#EAE5F4",
        "titleBar.activeForeground": "#211B2B",
        "tab.activeBackground": "#F8F7FC",
        "tab.activeForeground": "#211B2B",
        "tab.inactiveBackground": "#EAE5F4",
        "tab.inactiveForeground": "#756C81",
        "panel.background": "#F1EFF7",
        "panel.border": "#E1DCEB",
        "terminal.background": "#F8F7FC",
        "terminal.foreground": "#211B2B",
        "focusBorder": "#7045C5",
        "button.background": "#5B46CD",
        "button.foreground": "#FFFFFF",
        "badge.background": "#7045C5",
        "badge.foreground": "#FFFFFF"
    },
    "tokenColors": [
        { "name": "Comments", "scope": ["comment", "comment.line", "comment.block"], "settings": { "foreground": "#787083", "fontStyle": "italic" } },
        { "name": "Strings", "scope": ["string", "string.quoted"], "settings": { "foreground": "#8A416D" } },
        { "name": "String Interpolation", "scope": "variable.interpolation", "settings": { "foreground": "#5B46CD", "fontStyle": "bold" } },
        { "name": "Numbers", "scope": "constant.numeric", "settings": { "foreground": "#A35418" } },
        { "name": "Keywords", "scope": ["keyword.control", "keyword.declaration"], "settings": { "foreground": "#5B46CD", "fontStyle": "bold" } },
        { "name": "Modifiers", "scope": "keyword.modifier", "settings": { "foreground": "#A33263" } },
        { "name": "Booleans", "scope": "constant.language.boolean", "settings": { "foreground": "#A35418" } },
        { "name": "Null and Optional", "scope": "constant.language.null", "settings": { "foreground": "#7256A7" } },
        { "name": "Primitive Types", "scope": ["storage.type.primitive", "storage.type.sized"], "settings": { "foreground": "#176F75" } },
        { "name": "Type Names", "scope": "entity.name.type", "settings": { "foreground": "#4938A8" } },
        { "name": "Function Names", "scope": "entity.name.function", "settings": { "foreground": "#315F9C" } },
        { "name": "Builtin Functions", "scope": "support.function.builtin", "settings": { "foreground": "#83510E" } },
        { "name": "UI Functions", "scope": "support.function.ui", "settings": { "foreground": "#16745F", "fontStyle": "bold" } },
        { "name": "Color Functions", "scope": "support.function.color", "settings": { "foreground": "#A33263" } },
        { "name": "Animation Functions", "scope": "support.function.animation", "settings": { "foreground": "#7045C5", "fontStyle": "italic" } },
        { "name": "View Functions", "scope": "support.function.view", "settings": { "foreground": "#236B94" } },
        { "name": "Text Functions", "scope": "support.function.text", "settings": { "foreground": "#55752A" } },
        { "name": "Attributes", "scope": "entity.name.tag.attribute", "settings": { "foreground": "#A35418", "fontStyle": "italic" } },
        { "name": "Operators", "scope": "keyword.operator", "settings": { "foreground": "#7045C5" } },
        { "name": "Punctuation", "scope": "punctuation", "settings": { "foreground": "#51485D" } },
        { "name": "Variables", "scope": "variable.other", "settings": { "foreground": "#211B2B" } }
    ]
}
