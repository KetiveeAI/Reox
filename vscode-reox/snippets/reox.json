{
    "Main Function": {
        "prefix": "main",
        "body": [
            "fn main() -> int {",
            "\tprintln(\"Starting ${1:App}...\");",
            "\t$0",
            "\treturn 0;",
            "}"
        ],
        "description": "Main function entry point"
    },
    "App Boilerplate": {
        "prefix": "app",
        "body": [
            "struct App { handle: int }",
            "struct Window { handle: int }",
            "struct View { handle: int }",
            "",
            "fn main() -> int {",
            "\tlet app: App = app_new(\"${1:My App}\");",
            "\tlet window: Window = app_create_window(app, \"${2:Title}\", ${3:800}, ${4:600});",
            "\t",
            "\t// Root container",
            "\tlet root: View = vstack(${5:16.0});",
            "\tview_set_padding(root, insets_all(20.0));",
            "\tview_set_background(root, color_background());",
            "\t",
            "\t$0",
            "\t",
            "\twindow_set_root(window, root);",
            "\tapp_run(app);",
            "\treturn 0;",
            "}"
        ],
        "description": "Basic REOX application structure"
    },
    "VStack": {
        "prefix": "vstack",
        "body": [
            "let ${1:stack}: View = vstack(${2:16.0});"
        ],
        "description": "Vertical stack container"
    },
    "HStack": {
        "prefix": "hstack",
        "body": [
            "let ${1:row}: View = hstack(${2:16.0});"
        ],
        "description": "Horizontal stack container"
    },
    "Add Child": {
        "prefix": "add",
        "body": [
            "view_add_child(${1:parent}, ${2:child});"
        ],
        "description": "Add child view to container"
    },
    "Text View": {
        "prefix": "text",
        "body": [
            "let ${1:label}: View = text_view(\"${2:Content}\");",
            "text_set_color(${1:label}, color_text());",
            "text_set_font_size(${1:label}, ${3:16.0});"
        ],
        "description": "Text label with basic styling"
    },
    "Button": {
        "prefix": "button",
        "body": [
            "let ${1:btn}: View = button_view(\"${2:Click Me}\");",
            "// button_set_on_click(${1:btn}, action_id);"
        ],
        "description": "Button view"
    },
    "Card": {
        "prefix": "card",
        "body": [
            "let ${1:card}: View = vstack(${2:12.0});",
            "view_set_background(${1:card}, color_surface());",
            "view_set_padding(${1:card}, insets_all(${3:16.0}));",
            "view_set_corner_radius(${1:card}, ${4:12.0});",
            "view_set_shadow(${1:card}, shadow(0.0, 4.0, 12.0, color_rgba(0, 0, 0, 80)));",
            "$0"
        ],
        "description": "Styled card container"
    },
    "Set Background": {
        "prefix": "bg",
        "body": [
            "view_set_background(${1:view}, color_${2:surface}());"
        ],
        "description": "Set view background color"
    },
    "Set Padding": {
        "prefix": "padding",
        "body": [
            "view_set_padding(${1:view}, insets_all(${2:16.0}));"
        ],
        "description": "Set view padding"
    },
    "Set Corner Radius": {
        "prefix": "radius",
        "body": [
            "view_set_corner_radius(${1:view}, ${2:12.0});"
        ],
        "description": "Set view corner radius"
    },
    "Color RGBA": {
        "prefix": "rgba",
        "body": [
            "color_rgba(${1:255}, ${2:255}, ${3:255}, ${4:255})"
        ],
        "description": "Create RGBA color"
    },
    "For Loop": {
        "prefix": "for",
        "body": [
            "for ${1:i} in ${2:0}..${3:10} {",
            "\t$0",
            "}"
        ],
        "description": "For loop range"
    },
    "If Statement": {
        "prefix": "if",
        "body": [
            "if ${1:condition} {",
            "\t$0",
            "}"
        ],
        "description": "If statement"
    },
    "Function": {
        "prefix": "fn",
        "body": [
            "fn ${1:name}(${2:params}) -> ${3:void} {",
            "\t$0",
            "}"
        ],
        "description": "Function declaration"
    },
    "Struct": {
        "prefix": "struct",
        "body": [
            "struct ${1:Name} {",
            "\t${2:field}: ${3:type}",
            "}"
        ],
        "description": "Struct definition"
    },
    "Extern Function": {
        "prefix": "extern",
        "body": [
            "extern fn ${1:name}(${2:params}) -> ${3:void};"
        ],
        "description": "External function definition"
    },
    "Defer": {
        "prefix": "defer",
        "body": [
            "defer {",
            "\t$0",
            "}"
        ],
        "description": "Defer cleanup block"
    }
}